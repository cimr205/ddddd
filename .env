# ═══════════════════════════════════════════════════════════
#  LEAD GENERATION SYSTEM – Konfiguration
#  Alle services herunder er 100% GRATIS
#  Kør: python setup_wizard.py  for automatisk guide
# ═══════════════════════════════════════════════════════════

# ── AI EMAIL WRITING (vælg én) ───────────────────────────────
# Mulighed 1: Groq API – gratis signup på console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Mulighed 2: Ollama – lokal AI, ingen signup (https://ollama.ai)
# Kør: ollama pull llama3
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# (Mulighed 3: ingen – bruger automatisk smart templates)

# ── EMAIL SENDING (multi-konto, komma-adskilt) ───────────────
# Format: email:password@smtp-host:port
#
# Gmail (500/dag):   dinmail@gmail.com:AppPassword@smtp.gmail.com:587
# Brevo (300/dag):   dinmail@gmail.com:SMTPkey@smtp-relay.brevo.com:587
# Mailersend (100):  bruger@ms.net:password@smtp.mailersend.net:587
SMTP_ACCOUNTS=

# ── APP ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
