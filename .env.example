# Claude AI (required for personalized email writing)
ANTHROPIC_API_KEY=sk-ant-...

# SMTP Email Sending (add multiple accounts separated by comma for rotation)
# Format: user:password@host:port
SMTP_ACCOUNTS=user@gmail.com:password@smtp.gmail.com:587

# Optional: Hunter.io for email finding (free tier = 25/month)
HUNTER_API_KEY=

# Optional: ScrapingBee for bypassing bot detection (paid)
SCRAPINGBEE_API_KEY=

# App config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
