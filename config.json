{
  "system": "multi-agent-production",
  "version": "1.0.0",
  "agents": {
    "ceo": {
      "file": "agents/ceo_agent.md",
      "role": "orchestrator"
    },
    "browser": {
      "file": "agents/browser_agent.md",
      "role": "navigation"
    },
    "scraper": {
      "file": "agents/scraper_agent.md",
      "role": "lead_extraction"
    },
    "outreach": {
      "file": "agents/outreach_agent.md",
      "role": "email_generation"
    },
    "qa": {
      "file": "agents/qa_agent.md",
      "role": "evaluation"
    }
  },
  "core_loop": {
    "file": "core_loop.md",
    "min_success_score": 0.9,
    "retry_threshold": 0.8,
    "target_actions_per_loop": 20
  },
  "scraping": {
    "default_lead_target": 50,
    "required_fields": ["name", "company", "email"],
    "optional_fields": ["phone", "website"],
    "dedup": true
  },
  "outreach": {
    "max_email_length_words": 120,
    "min_personalization_score": 0.8
  }
}
